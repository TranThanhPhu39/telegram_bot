# Telegram — fill later
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BOT_WATCH_SYMBOLS=FPT:HOSE,ACB:HOSE

# Vietcap market data
VIETCAP_BASE_URL=https://trading.vietcap.com.vn
VIETCAP_SOCKET_URL=https://trading.vietcap.com.vn
VIETCAP_SOCKET_PATH=/ws/price/socket.io
VIETCAP_PROTO_URL=https://trading.vietcap.com.vn/protos/price.proto
VIETCAP_AUTHORIZATION=
VIETCAP_DEVICE_ID=
VIETCAP_COOKIE=
SECTOR_HISTORY_RETRY_ATTEMPTS=3
SECTOR_HISTORY_RETRY_BASE_SECONDS=2
SECTOR_HISTORY_SYNC_INTERVAL_SECONDS=21600
SECTOR_HISTORY_ON_DEMAND_COOLDOWN_SECONDS=900
SECTOR_HISTORY_MAX_MEMBERS_PER_RUN=8
SECTOR_NOTIFICATION_MAX_ATTEMPTS=5
SECTOR_NOTIFICATION_TTL_SECONDS=86400
SECTOR_NOTIFICATION_PURGE_INTERVAL_SECONDS=300

# App
LOG_LEVEL=INFO
VIETCAP_DEBUG_RAW=false

# Database — V1 may start with SQLite
DATABASE_URL=sqlite:///stock_bot.db

# News / Vietnamese financial sentiment
NEWS_DATABASE_PATH=news_sentiment.db
SENTIMENT_MODEL_BACKEND=phobert
SENTIMENT_MODEL_NAME=FiinGroup/phobert-finetuned
SENTIMENT_DEVICE=cpu
SENTIMENT_MODEL_CACHE_DIR=.model-cache/huggingface
SENTIMENT_FALLBACK_ENABLED=true
SENTIMENT_HALF_LIFE_HOURS=24
NEWS_HTTP_TIMEOUT=15
NEWS_COMPANY_CATALOG_URL=https://cafefnew.mediacdn.vn/Search/company.json
ASMF_NEWS_BLOCKER_ENABLED=true
ASMF_NEWS_BLOCKER_EVENTS=LEGAL
ASMF_NEWS_NEGATIVE_THRESHOLD=0.75
ASMF_NEWS_CONFIDENCE_THRESHOLD=0.70
ASMF_NEWS_MAX_AGE_HOURS=48


# Phase 23 — portfolio, risk and watchlist (exposure thresholds are % of portfolio value)
PORTFOLIO_SINGLE_STOCK_WARNING_PCT=25
PORTFOLIO_SINGLE_STOCK_HIGH_PCT=40
PORTFOLIO_SECTOR_WARNING_PCT=40
PORTFOLIO_SECTOR_HIGH_PCT=60
DEFAULT_RISK_PER_TRADE_PCT=1
MAX_RISK_PER_TRADE_PCT=5
PORTFOLIO_RISK_LOOKBACK=120
PORTFOLIO_RISK_MIN_SESSIONS=60

# Phase 25 — market coverage & refresh workers (background; never run by Telegram commands)
COVERAGE_WORKER_ENABLED=true
COVERAGE_DATASETS=FINANCIALS,INSTITUTIONAL,MARKET_HISTORY,SECTOR_HISTORY,NEWS
COVERAGE_BATCH_SIZE=20
COVERAGE_WORKER_INTERVAL=600
COVERAGE_STARTUP_DELAY=10
COVERAGE_REQUEST_DELAY=1.5
COVERAGE_MAX_RETRIES=2
COVERAGE_RETRY_BACKOFF=5
COVERAGE_ERROR_COOLDOWN=3600
COVERAGE_MISSING_COOLDOWN=259200
COVERAGE_SECTOR_REQUESTS_PER_CYCLE=2
FUNDAMENTAL_REFRESH_INTERVAL=604800
INSTITUTIONAL_REFRESH_INTERVAL=86400
MARKET_HISTORY_REFRESH_INTERVAL=86400
NEWS_REFRESH_INTERVAL=1800
NEWS_INGEST_LIMIT=30
# Issue 5 — on-demand per-ticker news refresh, triggered by /tin or
# /sentiment for a ticker with no eligible coverage (separate from the
# periodic sweep above).
NEWS_TARGETED_FETCH_LIMIT=60
NEWS_TARGETED_COOLDOWN_SECONDS=300
NEWS_WINDOW_DAYS=30
VNSTOCK_SOURCE_PREFERENCE=KBS,VCI,TCBS
YFINANCE_ENABLED=true
TCBS_ENABLED=true
# Phase 26 — bounded live acceptance scripts (leave empty to skip Telegram delivery)
# TEST_TELEGRAM_CHAT_ID is a chat you own; it is read from the environment only.
TEST_TELEGRAM_CHAT_ID=
